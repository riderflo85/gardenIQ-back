{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pytest:*)",
      "Bash(pipenv run pytest:*)",
      "Bash(black --check:*)",
      "Bash(isort --check-only:*)",
      "Bash(flake8:*)",
      "Bash(pre-commit run:*)",
      "Bash(./manage.py makemigrations --check:*)",
      "Bash(./manage.py showmigrations:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch --show-current)",
      "Bash(git branch -a)",
      "Bash(git branch --list:*)",
      "Bash(git fetch:*)",
      "Bash(gh auth status:*)",
      "Bash(gh repo view:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr list:*)",
      "Bash(gh label list:*)",
      "mcp__notion__notion-fetch",
      "mcp__notion__notion-search",
      "mcp__notion__notion-query-data-sources",
      "mcp__notion__notion-get-self",
      "mcp__notion__notion-get-users",
      "mcp__notion__notion-get-tool-access"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(pipenv run git push --force:*)",
      "Bash(pipenv run git push -f:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git commit -n:*)",
      "Bash(pipenv run git commit --no-verify:*)",
      "Bash(pipenv run git commit -n:*)",
      "Read(./.env)",
      "mcp__notion__notion-delete-pages",
      "mcp__notion__notion-delete-databases",
      "mcp__notion__notion-delete-comment",
      "mcp__notion__notion-update-data-source",
      "mcp__notion__notion-create-database"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(pipenv run git commit:*)",
      "Bash(git push:*)",
      "Bash(pipenv run git push:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh label create:*)",
      "mcp__notion__notion-create-pages",
      "mcp__notion__notion-update-page",
      "mcp__notion__notion-create-comment",
      "mcp__notion__notion-move-pages",
      "mcp__notion__notion-duplicate-page"
    ]
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true
  }
}
